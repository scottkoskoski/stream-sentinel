# Multi-stage Dockerfile for Stream-Sentinel consumer images
#
# Build:
#   docker build -f docker/Dockerfile.consumer -t stream-sentinel-consumer:latest .
#
# Run (select consumer via CMD):
#   docker run stream-sentinel-consumer:latest python -m src.consumers.fraud_detector
#   docker run stream-sentinel-consumer:latest python -m src.consumers.alert_processor
#   docker run stream-sentinel-consumer:latest python -m src.consumers.persistence_consumer
#   docker run stream-sentinel-consumer:latest python -m src.consumers.dlq_consumer
#   docker run stream-sentinel-consumer:latest python -m src.consumers.enhanced_fraud_detector

# ---------------------------------------------------------------------------
# Stage 1: Install Python dependencies and build the native C++ inference
# extension. The resulting simple_xgboost_cpp.*.so is copied into the
# runtime image so consumers can use the accelerated inference path.
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS builder

WORKDIR /build

# Install system dependencies needed to compile native extensions and the
# C++ inference wrapper (requires g++ with C++17 support, make).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        libpq-dev \
        && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Build the native C++ XGBoost inference wrapper. This produces
# simple_xgboost_cpp.cpython-*.so in src/inference/cpp/ which is then
# copied into the runtime image.
COPY src/inference/cpp /build/src/inference/cpp
RUN PATH="/opt/venv/bin:$PATH" \
    && cd /build/src/inference/cpp \
    && make clean \
    && make \
    && ls -la *.so

# ---------------------------------------------------------------------------
# Stage 2: Slim runtime image
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS runtime

# Install only the shared libraries needed at runtime (no compilers)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
        && rm -rf /var/lib/apt/lists/*

# Copy the pre-built virtualenv from the builder stage
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create a non-root user for running the application
RUN groupadd --gid 1000 sentinel && \
    useradd --uid 1000 --gid sentinel --shell /bin/bash --create-home sentinel

WORKDIR /app

# Copy application source code and model artifacts
COPY src/ src/
COPY models/ models/

# Copy the prebuilt C++ inference wrapper from the builder stage so the
# consumer can use the accelerated path without rebuilding at runtime.
COPY --from=builder /build/src/inference/cpp/*.so /app/src/inference/cpp/

# Ensure the non-root user owns the application directory
RUN chown -R sentinel:sentinel /app

USER sentinel

# Expose the default metrics port range (override per-consumer with --env)
EXPOSE 8000

# Health check against the consumer's metrics/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -f http://localhost:${METRICS_PORT:-8000}/health || exit 1

# Default entrypoint -- override CMD when running different consumers
ENTRYPOINT ["python", "-m"]
CMD ["src.consumers.fraud_detector"]
