# ===============================================================================
# Stream-Sentinel Environment Configuration Template
# ===============================================================================
# 
# SECURITY NOTICE:
# 1. Copy this file to ".env" and update all passwords and secrets
# 2. Never commit the real ".env" file to version control
# 3. Use strong, unique passwords for each service (minimum 32 characters)
# 4. Rotate passwords regularly in production environments
#
# USAGE:
# - Development: docker-compose --env-file .env up -d
# - Production: Use with external secrets management (Vault, K8s secrets, etc.)
#
# Generate secure passwords with:
# openssl rand -base64 32
#
# ===============================================================================

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment identifier (development, staging, production)
STREAM_SENTINEL_ENV=development

# Application version and build info
APP_VERSION=1.0.0
BUILD_TIMESTAMP=2025-01-01T00:00:00Z

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================

# Kafka connection settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_STAGING_SERVERS=kafka-staging:9092
KAFKA_PROD_SERVERS=kafka-prod-1:9092,kafka-prod-2:9092,kafka-prod-3:9092

# Kafka authentication (for secure environments)
KAFKA_USERNAME=stream_sentinel_user
KAFKA_PASSWORD=CHANGEME-kafka-password-min-32-chars-required
KAFKA_ADMIN_PASSWORD=CHANGEME-kafka-admin-password-min-32-chars-required
KAFKA_PRODUCER_PASSWORD=CHANGEME-kafka-producer-password-min-32-chars-required
KAFKA_CONSUMER_PASSWORD=CHANGEME-kafka-consumer-password-min-32-chars-required

# Kafka performance tuning
KAFKA_MAX_POLL_RECORDS=500
KAFKA_FETCH_MIN_BYTES=1024
KAFKA_FETCH_MAX_WAIT_MS=500

# Kafka debugging (set to 'all' for troubleshooting)
KAFKA_DEBUG=generic,metadata

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# Redis authentication
REDIS_PASSWORD=CHANGEME-redis-password-min-32-chars-required

# Redis performance settings
REDIS_MAX_CONNECTIONS=100
REDIS_CONNECTION_TIMEOUT=30
REDIS_SOCKET_KEEPALIVE=true
REDIS_SOCKET_KEEPALIVE_OPTIONS=1,1,3

# Redis clustering (for production)
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379,redis-3:6379

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================

# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stream_sentinel
POSTGRES_USER=stream_sentinel_user
POSTGRES_PASSWORD=CHANGEME-postgres-password-min-32-chars-required

# PostgreSQL connection pool settings
POSTGRES_MIN_CONNECTIONS=5
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_CONNECTION_TIMEOUT=30
POSTGRES_IDLE_TIMEOUT=300

# PostgreSQL SSL settings (for production)
POSTGRES_SSL_MODE=prefer
POSTGRES_SSL_CERT_FILE=/certs/client.crt
POSTGRES_SSL_KEY_FILE=/certs/client.key
POSTGRES_SSL_CA_FILE=/certs/ca.crt

# =============================================================================
# CLICKHOUSE CONFIGURATION
# =============================================================================

# ClickHouse connection settings
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=stream_sentinel
CLICKHOUSE_USER=stream_sentinel_user
CLICKHOUSE_PASSWORD=CHANGEME-clickhouse-password-min-32-chars-required

# ClickHouse performance settings
CLICKHOUSE_TIMEOUT=300
CLICKHOUSE_INSERT_BLOCK_SIZE=1000000
CLICKHOUSE_MAX_EXECUTION_TIME=300
CLICKHOUSE_COMPRESSION=lz4

# ClickHouse security settings
CLICKHOUSE_SECURE=false
CLICKHOUSE_SSL_CERT_PATH=/certs/clickhouse.crt
CLICKHOUSE_SSL_KEY_PATH=/certs/clickhouse.key
CLICKHOUSE_SSL_CA_PATH=/certs/ca.crt

# =============================================================================
# SCHEMA REGISTRY CONFIGURATION
# =============================================================================

# Schema Registry connection
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_STAGING=http://schema-registry-staging:8081
SCHEMA_REGISTRY_PROD=http://schema-registry-prod:8081

# Schema Registry authentication
SCHEMA_REGISTRY_USERNAME=schema_registry_user
SCHEMA_REGISTRY_PASSWORD=CHANGEME-schema-registry-password-min-32-chars-required

# Schema Registry SSL settings
SCHEMA_REGISTRY_SSL_VERIFY=true
SCHEMA_REGISTRY_SSL_CERT_PATH=/certs/schema-registry.crt
SCHEMA_REGISTRY_SSL_KEY_PATH=/certs/schema-registry.key

# =============================================================================
# KAFKA UI CONFIGURATION
# =============================================================================

# Kafka UI authentication
KAFKA_UI_USERNAME=admin
KAFKA_UI_PASSWORD=CHANGEME-kafka-ui-password-min-32-chars-required

# Kafka UI configuration
KAFKA_UI_CLUSTERS_0_NAME=stream-sentinel-cluster
KAFKA_UI_AUTH_TYPE=LOGIN_FORM

# =============================================================================
# FRAUD DETECTION CONFIGURATION
# =============================================================================

# Fraud detection model settings
FRAUD_THRESHOLD=0.7
FRAUD_MODEL_PATH=models/ieee_fraud_model_production.pkl
FRAUD_MODEL_CPP_ACCELERATION=true
FRAUD_MODEL_BATCH_SIZE=1000

# Feature engineering settings
FEATURE_CACHE_TTL=3600
FEATURE_CACHE_SIZE=10000
USER_PROFILE_CACHE_TTL=86400

# Alert processing settings
ALERT_NOTIFICATION_EMAIL=alerts@your-company.com
ALERT_NOTIFICATION_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
ALERT_HIGH_PRIORITY_THRESHOLD=0.9
ALERT_CRITICAL_PRIORITY_THRESHOLD=0.95

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================

# Model training settings
ML_MODEL_TYPE=lightgbm
ML_DEVICE=cpu
ML_N_TRIALS=100
ML_OPTIMIZATION_TIMEOUT=3600

# Online learning settings
ONLINE_LEARNING_ENABLED=true
ONLINE_LEARNING_BATCH_SIZE=1000
ONLINE_LEARNING_UPDATE_FREQUENCY=300
DRIFT_DETECTION_THRESHOLD=0.05
DRIFT_DETECTION_MIN_SAMPLES=1000

# Model registry settings
MODEL_REGISTRY_BACKEND=local
MODEL_REGISTRY_URI=models/
MODEL_REGISTRY_S3_BUCKET=stream-sentinel-models
MODEL_REGISTRY_S3_PREFIX=production/

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_NAMESPACE=stream_sentinel

# Health check settings
DB_HEALTH_CHECK_INTERVAL=30
DB_POOL_MONITORING=true
DB_QUERY_TRACKING=true
DB_SLOW_QUERY_THRESHOLD=1000
DB_METRICS_EXPORT=true

# Application monitoring
MONITORING_ENABLED=true
MONITORING_INTERVAL=60
MONITORING_EXPORT_PROMETHEUS=true

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# System resource limits
MAX_MEMORY_USAGE=4GB
MAX_CPU_CORES=4
WORKER_THREADS=8
IO_THREADS=4

# Cache settings
CACHE_SIZE_MB=512
CACHE_TTL_SECONDS=3600
CACHE_CLEANUP_INTERVAL=300

# Kafka consumer performance
KAFKA_CONSUMER_THREADS=4
KAFKA_CONSUMER_BATCH_SIZE=1000
KAFKA_CONSUMER_POLL_TIMEOUT=1000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# SSL/TLS settings
SSL_ENABLED=false
SSL_CERT_PATH=/certs/server.crt
SSL_KEY_PATH=/certs/server.key
SSL_CA_PATH=/certs/ca.crt
SSL_VERIFY_HOSTNAME=true

# Certificate passwords (for secure environments)
SSL_TRUSTSTORE_PASSWORD=CHANGEME-truststore-password-min-16-chars
SSL_KEYSTORE_PASSWORD=CHANGEME-keystore-password-min-16-chars
SSL_KEY_PASSWORD=CHANGEME-ssl-key-password-min-16-chars

# Authentication settings
AUTH_ENABLED=false
AUTH_SECRET_KEY=CHANGEME-auth-secret-key-min-64-chars-required-for-jwt
AUTH_TOKEN_EXPIRY=3600
AUTH_REFRESH_TOKEN_EXPIRY=86400

# Network security
NETWORK_ENCRYPTION=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ENABLED=true
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test environment settings
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5433/test_stream_sentinel
TEST_REDIS_URL=redis://localhost:6380/1
TEST_KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Test data settings
GENERATE_SYNTHETIC_DATA=true
SYNTHETIC_DATA_RATE=100
SYNTHETIC_FRAUD_RATE=0.03
LOAD_TEST_DURATION=300

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development tools
DEBUG_MODE=false
DEVELOPMENT_MODE=true
HOT_RELOAD=true
VERBOSE_LOGGING=false

# Development database (separate from production)
DEV_POSTGRES_PASSWORD=dev-postgres-password-not-for-production
DEV_REDIS_PASSWORD=dev-redis-password-not-for-production
DEV_CLICKHOUSE_PASSWORD=dev-clickhouse-password-not-for-production

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# External API keys (if needed)
EXTERNAL_API_KEY=your-external-api-key-here
EXTERNAL_API_SECRET=your-external-api-secret-here

# Cloud provider settings (if applicable)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-west-2

# S3 settings for model storage
S3_BUCKET_NAME=stream-sentinel-models
S3_BUCKET_REGION=us-west-2
S3_BUCKET_PREFIX=models/

# =============================================================================
# BACKUP AND DISASTER RECOVERY
# =============================================================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=stream-sentinel-backups
BACKUP_ENCRYPTION_KEY=CHANGEME-backup-encryption-key-min-64-chars

# Disaster recovery settings
DR_ENABLED=false
DR_REPLICATION_FACTOR=3
DR_BACKUP_FREQUENCY=daily
DR_RESTORE_POINT_RETENTION=7

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Audit logging
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_S3_BUCKET=stream-sentinel-audit-logs

# Compliance settings
GDPR_COMPLIANCE=true
SOX_COMPLIANCE=false
PCI_COMPLIANCE=false
DATA_RETENTION_DAYS=2555

# =============================================================================
# PASSWORD GENERATION EXAMPLES
# =============================================================================
#
# Generate secure passwords using these commands:
#
# For general service passwords (32+ characters):
# openssl rand -base64 32
#
# For SSL certificate passwords (16+ characters):
# openssl rand -base64 16
#
# For JWT secrets (64+ characters):
# openssl rand -base64 64 | tr -d '\n'
#
# For Kafka SASL passwords (no special characters):
# openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
#
# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
#
# Before deploying to production:
#
# [ ] All CHANGEME passwords have been replaced with secure values
# [ ] All passwords are unique and meet minimum length requirements  
# [ ] SSL certificates have been generated and paths configured
# [ ] Network security groups/firewall rules are configured
# [ ] Backup encryption keys are stored securely off-site
# [ ] Access logs are configured and monitored
# [ ] Security monitoring alerts are configured
# [ ] Incident response procedures are documented and tested
# [ ] Regular security audits are scheduled
# [ ] Key rotation policies are implemented
# [ ] Multi-factor authentication is enabled for admin access
# [ ] Network segmentation is properly configured
# [ ] All default accounts have been disabled or secured
#
# =============================================================================
# IMPORTANT NOTES
# =============================================================================
#
# 1. NEVER commit this file with real passwords to version control
# 2. Use a secrets management system in production (Vault, K8s secrets, etc.)
# 3. Implement proper key rotation procedures
# 4. Monitor for unauthorized access attempts
# 5. Regular security assessments and penetration testing
# 6. Keep all dependencies and services updated
# 7. Implement proper network segmentation
# 8. Use least-privilege access principles
# 9. Implement comprehensive logging and monitoring
# 10. Have tested disaster recovery procedures
#
# =============================================================================