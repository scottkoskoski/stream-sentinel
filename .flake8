[flake8]
max-line-length = 120
# E203, W503: defer to black's formatting (PEP 8 disagreements).
# E402: the consumers/producers bootstrap sys.path before importing local
#       packages (sys.path.append(...) then `from kafka.config import ...`),
#       so module-level imports legitimately appear after that statement.
# E501: black owns line length (line-length=120). The only residual lines
#       over the limit are string literals black will not split (log/assert
#       messages and inline SQL), so we let black be the source of truth.
extend-ignore = E203, W503, E402, E501
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    *.egg-info,
    src/inference/cpp,
    .claude
per-file-ignores =
    src/testing/*:F821,F401
    src/ml/serving/tests/*:F821,F401
    tests/*:E501
